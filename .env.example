# Copy to .env and put your key there. Never commit .env.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Blank uses GEMINI_MODEL.
GEMINI_REVIEW_MODEL=
# OpenAI remains available by setting AI_PROVIDER=openai.
OPENAI_API_KEY=
# Choose a model your API project can access with Responses + Structured Outputs.
OPENAI_MODEL=gpt-4o-mini
# Optional second-pass reviewer model; blank uses OPENAI_MODEL.
OPENAI_REVIEW_MODEL=
# Global process-local call cap, reset daily in UTC or on restart. Not a billing cap.
AI_DAILY_CALL_LIMIT=50
HOST=127.0.0.1
PORT=8000
# Optional canonical HTTPS origin for a reverse proxy deployment.
PUBLIC_ORIGIN=
# Set false on a public demo to require each visitor's own key.
ALLOW_SERVER_AI=true
